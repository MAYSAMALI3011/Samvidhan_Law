# ==============================================================================
# Samvidhan Environment Variables
# ==============================================================================

# Backend API Base URL (e.g., https://api.samvidhan.in or http://localhost:5000)
# Leave blank to use relative paths with the Vite dev proxy.
VITE_API_URL=

# Mock Data Mode
# - "true"  : Uses client-side simulated data and mock handlers (DEV ONLY).
# - "false" : Directs all requests to the configured live backend API.
# Note: In production builds (import.meta.env.PROD), mock mode is strictly disabled.
VITE_USE_MOCKS=false

# Dev-only mock role when VITE_USE_MOCKS=true (learner, editor, reviewer, admin, superadmin)
# VITE_DEV_MOCK_ROLE=superadmin
