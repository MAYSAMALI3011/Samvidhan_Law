# Samvidhan Development Environment
# When VITE_USE_MOCKS is true, client simulated services are active in DEV.
VITE_USE_MOCKS=true

# Optional local/remote backend URL (e.g. http://localhost:5000)
VITE_API_URL=

# Dev-only mock role for testing administrative console (learner, editor, reviewer, admin, superadmin)
VITE_DEV_MOCK_ROLE=superadmin
