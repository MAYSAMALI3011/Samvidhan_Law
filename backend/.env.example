# Samvidhan Backend Environment Configuration (Placeholders only)
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,https://maysamali3011.github.io

# Supabase Configuration
# Accept either naming: SUPABASE_ANON_KEY or SUPABASE_PUBLISHABLE_KEY;
# SUPABASE_SERVICE_ROLE_KEY or SUPABASE_SECRET_KEY
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Frontend URL for email redirect links
FRONTEND_URL=http://localhost:5173

# Cookies and Security
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
CSRF_STRICT=true
APP_TIMEZONE=Asia/Kolkata

# AI Chat Quotas
GUEST_DAILY_AI_LIMIT=3
FREE_DAILY_AI_LIMIT=5
AI_PROVIDER_ORDER=gemini,groq,mistral,openrouter
AI_REQUEST_TIMEOUT_SECONDS=25.0
AI_DEFAULT_ANSWER=Our AI assistant is very busy right now. Please try again a little later, or browse the Library and Constitution sections in the meantime.

# Free-Tier AI Providers (Empty keys will be automatically skipped)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
